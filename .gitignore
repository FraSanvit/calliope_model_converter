# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tools and caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints
.env
.venv

# Pixi: environments are rebuilt from pixi.toml + pixi.lock (tracked)
.pixi/*
!.pixi/config.toml

# Workflow inputs and outputs (Modelblocks convention): only the folder structure is tracked
resources/user/*
!resources/user/.gitkeep
results/
logs/
.snakemake/
*.log

# Integration test outputs
tests/integration/results/
tests/integration/resources/
tests/integration/.snakemake/
